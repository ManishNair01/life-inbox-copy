GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: defaults to GEMINI_MODEL
# GEMINI_TRANSCRIPTION_MODEL=
# Max simultaneous Gemini requests (default 4)
# GEMINI_MAX_CONCURRENT=4
# Gemini calls allowed per user per UTC day (default 100, 0 = unlimited)
# GEMINI_DAILY_CALL_LIMIT=100
# Seconds to pause Gemini calls after 3 straight 429s (default 60, 0 = never pause)
# GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=60
