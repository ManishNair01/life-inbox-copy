NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_ASR_MODEL=openai/whisper-large-v3
LIFE_INBOX_VAPID_PUBLIC_KEY=
LIFE_INBOX_VAPID_PRIVATE_KEY=
LIFE_INBOX_VAPID_SUBJECT=mailto:admin@example.com
DATABASE_URL=sqlite:///data/life_inbox.db

# Optional: Sign in with Google (see README). Leave blank to hide the button.
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Optional: send real password-reset emails (default prints codes in the server terminal)
# LIFE_INBOX_EMAIL_PROVIDER=smtp
# LIFE_INBOX_SMTP_HOST=smtp.gmail.com
# LIFE_INBOX_SMTP_PORT=587
# LIFE_INBOX_SMTP_USER=
# LIFE_INBOX_SMTP_PASSWORD=
# LIFE_INBOX_SMTP_FROM=
